# ==================================================
# 富邦證券 API MCP Server 環境變數範例
# Fubon API MCP Server Environment Variables Example
# ==================================================

# --------------------------------------------------
# 方式一：傳統 PFX 憑證認證（Traditional PFX Certificate Authentication）
# 需要：FUBON_USERNAME + FUBON_PASSWORD + FUBON_PFX_PATH
# Required: FUBON_USERNAME + FUBON_PASSWORD + FUBON_PFX_PATH
# --------------------------------------------------
FUBON_USERNAME=您的富邦證券帳號
FUBON_PASSWORD=您的富邦證券密碼
FUBON_PFX_PATH=/path/to/your/certificate.pfx
FUBON_PFX_PASSWORD=您的憑證密碼（如果有）

# --------------------------------------------------
# 方式二：API-Key 認證（SDK v2.2.8+）
# 需要：FUBON_USERNAME + FUBON_API_KEY + FUBON_PFX_PATH
# Required: FUBON_USERNAME + FUBON_API_KEY + FUBON_PFX_PATH
# 
# 申請 API Key / Apply for API Key:
# https://www.fbs.com.tw/TradeAPI/docs/key/
# --------------------------------------------------
# FUBON_API_KEY=your_api_key_here
# FUBON_PFX_PATH=/path/to/exported/web-certificate.pfx
# FUBON_PFX_PASSWORD=your_certificate_password

# --------------------------------------------------
# 共用設定（Optional Settings）
# --------------------------------------------------
FUBON_DATA_DIR=/path/to/your/data/directory

# --------------------------------------------------
# MCP v2 transport（Optional；預設 stdio）
# MCP v2 transport (Optional; defaults to stdio)
# --------------------------------------------------
# 桌面 MCP Host 使用 stdio；遠端部署可使用新版無狀態 Streamable HTTP。
FUBON_MCP_TRANSPORT=stdio
FUBON_MCP_HOST=127.0.0.1
FUBON_MCP_PORT=8000
FUBON_MCP_HTTP_PATH=/mcp
# Streamable HTTP 預設啟用 stateless，符合 MCP 2026-07-28。
FUBON_MCP_STATELESS_HTTP=true
FUBON_MCP_JSON_RESPONSE=false
# 僅相容舊版 SSE client 時使用：
# FUBON_MCP_SSE_PATH=/sse
# FUBON_MCP_MESSAGE_PATH=/messages/

# --------------------------------------------------
# 注意事項 / Notes:
# 1. 系統會自動偵測使用哪種認證方式
#    System will automatically detect which authentication method to use
# 2. 如果同時設定兩種方式，優先使用 API-Key 認證
#    If both methods are configured, API-Key authentication takes precedence
# 3. 請勿將此文件提交到版本控制
#    Do not commit this file to version control
# --------------------------------------------------
